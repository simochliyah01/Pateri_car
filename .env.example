# ====================================================
# PATERI CAR - Environment Variables Template
# ====================================================
# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed.
# ====================================================

# ---------- PostgreSQL ----------
POSTGRES_DB=patericar_db
POSTGRES_USER=patericar
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_PORT=5432

# ---------- Backend (Spring Boot) ----------
BACKEND_PORT=8080
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=change_me_use_openssl_rand_base64_64

# ---------- Frontend ----------
FRONTEND_PORT=80
FRONTEND_CLIENT_URL=http://localhost
FRONTEND_ADMIN_URL=http://localhost
